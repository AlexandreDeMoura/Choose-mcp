{
  "name": "choose-mcp",
  "version": "0.1.0",
  "description": "MCP server scaffold for Choose-MCP",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "check": "tsc -p tsconfig.server.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js"
  },
  "keywords": [
    "mcp",
    "typescript",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
